PORT=3001
JWT_SECRET=change-me
# Optional override — defaults to backend/data/coefficient.db if unset
# DB_PATH=./data/coefficient.db

# DEV ONLY: true shows one-click login buttons (admin + every existing user)
# on the login screen and enables passwordless login endpoints. Anyone who can
# reach the server can then log in as anyone. Keep false (or remove) anywhere
# other than your own dev machine. Ignored when NODE_ENV=production.
DEV_QUICK_LOGIN=false
