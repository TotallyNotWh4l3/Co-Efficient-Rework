{
    "name": "CoEfficient",
    "version": "1.1.0",
    "main": "electron-main.js",
    "scripts": {
        "dev:backend": "cd backend && npm run dev",
        "dev:frontend": "cd frontend && npm run dev",
        "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
        "electron": "electron .",
        "build:frontend": "cd frontend && npm run build",
        "package": "npm run build:frontend && electron-builder"
    },
    "build": {
        "appId": "com.yourcompany.coefficient",
        "files": [
            "electron-main.js",
            "backend/**/*",
            "!backend/node_modules/**/*",
            "frontend/dist/**/*"
        ],
        "extraResources": [
            {
                "from": "backend/.env",
                "to": "backend/.env"
            }
        ],
        "forceCodeSigning": false,
        "npmRebuild": false,
        "win": {
            "target": "nsis",
            "icon": "frontend/public/favicon.ico"
        }
    },
    "devDependencies": {
        "concurrently": "^8.0.0",
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3"
    },
    "dependencies": {
        "tree-cli": "^0.6.7"
    }
}
